---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Join the Georgia Tech Energy Solutions VIP: audit real campus buildings, recommend upgrades, and help Georgia Tech meet UN SDG 7 and its net-zero goals.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/the-issue', label: 'The Issue' },
  { href: '/the-vip', label: 'The VIP' },
  { href: '/get-involved', label: 'Get Involved' },
  { href: '/sources', label: 'Sources' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | GT Energy Solutions VIP</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="GT Energy Solutions VIP, home">
          <span class="brand-mark" aria-hidden="true">7</span> GT Energy Solutions VIP
        </a>
        <nav aria-label="Main">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          The <strong>GT Energy Solutions VIP</strong> is a for-credit research team, taught with the
          <a href="https://sustain.gatech.edu/our-team/">Office of Sustainability</a>, where students put
          <a href="https://sdgs.un.org/goals/goal7">UN SDG 7: Affordable and Clean Energy</a> into practice on Georgia
          Tech's own campus, in support of <a href="https://sustain.gatech.edu/sustainability-next-plan/">Sustainability Next</a>
          and the Climate Action Plan.
        </p>
        <p class="small">
          Created for LMC 3403, Unit 2, by Jesus Sierra Jr., Joshua Lewis, Hardik Uppal, and Quintin Buckley as a
          recruiting site for the VIP. Not an official Georgia Tech website. Program details change, so confirm with the
          <a href="https://vip.gatech.edu/teams-all-in-one/entry/1252/">VIP team listing</a> before applying.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(251, 250, 247, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .site-header .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.8rem 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--navy);
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 6px;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 1rem;
  }
  .site-header ul {
    flex-wrap: wrap;
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header nav a {
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .site-header nav a:hover {
    color: var(--navy);
    background: var(--gold-soft);
  }
  .site-header nav a[aria-current='page'] {
    color: #fff;
    background: var(--navy);
  }
  .site-footer {
    background: var(--navy-deep);
    color: #c9d6e2;
    padding: 2rem 0;
    font-size: 0.95rem;
  }
  .site-footer p {
    margin: 0 0 0.6rem;
    max-width: 46rem;
  }
  .site-footer a {
    color: #fff;
  }
  .site-footer .small {
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
