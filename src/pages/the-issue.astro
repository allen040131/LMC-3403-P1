---
import Layout from '../layouts/Layout.astro';

// EIA, Net Generation by State (1990-2024), Georgia 2024 totals. Shares of 139.8 million MWh.
const mix = [
  {
    id: 'gas',
    label: 'Natural gas',
    pct: 40.7,
    fossil: true,
    note: 'Georgia’s largest source of electricity. Burning gas releases CO₂, and methane can leak from wells and pipelines before it ever reaches a power plant.',
  },
  {
    id: 'nuclear',
    label: 'Nuclear',
    pct: 34.3,
    fossil: false,
    note: 'Carbon-free when running. Plant Vogtle’s new Unit 4 came online in 2024, making Vogtle the largest nuclear plant in the U.S., at a cost of over $30 billion.',
  },
  {
    id: 'coal',
    label: 'Coal',
    pct: 12.8,
    fossil: true,
    note: 'The most carbon-intensive fuel on the grid: coal releases more CO₂ per unit of electricity than any other source.',
  },
  {
    id: 'solar',
    label: 'Solar',
    pct: 6.6,
    fossil: false,
    note: 'Georgia’s largest renewable source. Campus rooftops like the Kendeda Building show that solar works here, too.',
  },
  {
    id: 'biomass',
    label: 'Wood & biomass',
    pct: 3.8,
    fossil: false,
    note: 'Mostly wood waste from Georgia’s forestry and paper industries, burned to make power and heat.',
  },
  {
    id: 'hydro',
    label: 'Hydroelectric',
    pct: 2.1,
    fossil: false,
    note: 'Power from dams on Georgia rivers. A steady but small part of the mix with little room to grow.',
  },
];
const max = Math.max(...mix.map((m) => m.pct));
---

<Layout title="The Issue">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">The Issue</span>
      <h1>Every lab, dorm, and lecture hall plugs into a fossil-fuel grid.</h1>
      <p class="lead">
        Charging your laptop in the library, running the AC through an Atlanta August, keeping a lab freezer cold: you use
        energy every second of the day, and most of it comes from fossil fuels. Georgia Tech can’t choose its grid, but it
        can choose how much energy its buildings use. So can you.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2>Why this is your problem, too</h2>
      <p>Energy isn’t just a campus statistic. It shows up in your wallet, your city, your job search, and your graduation year.</p>
      <div class="grid personal">
        <div class="card">
          <span class="tag">Your first apartment</span>
          <strong class="big">+$43/mo</strong>
          <p>
            Six Georgia Power rate increases since 2023 have added an average of $43 a month to a household bill. That’s the
            bill you’ll pay when you move off campus, and wasted energy makes it bigger.
          </p>
        </div>
        <div class="card">
          <span class="tag">Your city</span>
          <strong class="big">1 in 7</strong>
          <p>
            About 14% of metro Atlanta households spend more than a tenth of their income on energy bills. The
            neighborhoods around campus feel this most. The long-term fix is the same skill the VIP teaches: making buildings
            efficient.
          </p>
        </div>
        <div class="card">
          <span class="tag">Your career</span>
          <strong class="big">85,535</strong>
          <p>
            Clean energy jobs in Georgia in 2024, nearly 16,000 of them in Fulton County alone. The sector added jobs more
            than five times faster than the state’s economy overall.
          </p>
        </div>
        <div class="card">
          <span class="tag">Your class year</span>
          <strong class="big">2030</strong>
          <p>
            The year Georgia Tech promised to cut its emissions in half, and the year this fall’s first-year students
            graduate. Whether campus hits that target will be decided while you’re here.
          </p>
        </div>
      </div>
      <p class="cite">
        Sources:
        <a href="https://www.ajc.com/business/2026/02/georgia-power-floats-plan-to-lower-customers-monthly-bills">Atlanta Journal-Constitution (Feb. 2026)</a>;
        <a href="https://www.aceee.org/sites/default/files/pdfs/aceee-01_energy_burden_-_atlanta.pdf">ACEEE, Energy Burdens in Atlanta (2020)</a>;
        <a href="https://e2.org/reports/clean-jobs-georgia-2025">E2, Clean Jobs Georgia 2025</a>;
        <a href="https://sustain.gatech.edu/2024/04/05/climate-action-plan-provides-road-map-to-net-zero-emissions/">GT Climate Action Plan</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Where Georgia’s electricity comes from</h2>
      <p>
        Most of the electricity Georgia Tech buys comes off the state grid. In 2024, about <strong>54%</strong> of that grid
        ran on fossil fuels. Select a source to learn more.
      </p>

      <figure class="mixchart" aria-labelledby="mix-caption">
        <div class="legend" aria-hidden="true">
          <span><i class="sw fossil"></i>Fossil fuel</span>
          <span><i class="sw clean"></i>Non-fossil</span>
        </div>
        <div class="bars" role="group" aria-label="Georgia electricity sources, 2024">
          {
            mix.map((m, i) => (
              <button
                type="button"
                class="bar-row"
                data-id={m.id}
                data-label={m.label}
                data-pct={m.pct}
                data-note={m.note}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span class="bar-label">{m.label}</span>
                <span class="bar-track">
                  <span class={`bar ${m.fossil ? 'fossil' : 'clean'}`} style={`width: ${(m.pct / max) * 100}%`} />
                </span>
                <span class="bar-value">
                  {m.pct}%<span class="kind">{m.fossil ? 'fossil' : 'non-fossil'}</span>
                </span>
              </button>
            ))
          }
        </div>
        <div class="detail" aria-live="polite">
          <strong id="mix-title">{mix[0].label}: {mix[0].pct}%</strong>
          <p id="mix-note">{mix[0].note}</p>
        </div>
        <figcaption id="mix-caption" class="cite">
          Share of Georgia’s 2024 net electricity generation. Petroleum and other sources are under 1%. Source:
          <a href="https://www.eia.gov/electricity/data/state/">U.S. EIA, Net Generation by State</a>;
          <a href="https://www.eia.gov/todayinenergy/detail.php?id=61963">EIA on Plant Vogtle (2024)</a>.
        </figcaption>
        <details class="table-view">
          <summary>View as a table</summary>
          <table>
            <thead><tr><th scope="col">Source</th><th scope="col">Share</th><th scope="col">Type</th></tr></thead>
            <tbody>
              {mix.map((m) => (<tr><td>{m.label}</td><td>{m.pct}%</td><td>{m.fossil ? 'Fossil' : 'Non-fossil'}</td></tr>))}
            </tbody>
          </table>
        </details>
      </figure>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2>What that means for Georgia Tech</h2>
      <div class="stats">
        <div class="stat-tile">
          <strong>216,752</strong>
          <p>Metric tons of CO₂e emitted by Georgia Tech in FY2025. Purchased electricity is the largest source.</p>
        </div>
        <div class="stat-tile">
          <strong>60 / 40</strong>
          <p>Campus energy split between electricity and natural gas, which heats buildings and makes steam.</p>
        </div>
        <div class="stat-tile">
          <strong>−25%</strong>
          <p>Drop in energy used per square foot since FY2015, even as on-campus students grew 34%.</p>
        </div>
      </div>
      <p style="margin-top: 1.5rem">
        That last number is the hopeful one: efficiency works. Chiller-plant upgrades alone save 12.7 million kWh a year.
        Georgia Tech’s 2025 Utilities Master Plan calls for <strong>2 MW of new campus solar</strong> and electrifying
        campus heating. Those projects need people who understand energy, data, buildings, and how to persuade others to
        act.
      </p>
      <p class="cite">
        Sources:
        <a href="https://sustain.gatech.edu/impact-area-emissions/">GT Office of Sustainability, Emissions</a>;
        <a href="https://sustain.gatech.edu/files/2026/02/Georgia-Tech-2025-Annual-Utility-Report-Final-1.pdf">FY2025 Annual Utility Report</a>;
        <a href="https://sustain.gatech.edu/files/2026/02/2025-Sustainability-Report_2.2026_SPREADS.pdf">2025 Sustainability Report</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">The global goal</span>
        <h2>UN SDG 7: Affordable and Clean Energy</h2>
        <p>
          <a href="https://sdgs.un.org/goals/goal7">Sustainable Development Goal 7</a> calls for affordable, reliable,
          sustainable, and modern energy for all. Two of its targets map directly onto our campus:
        </p>
        <ul class="checklist">
          <li><strong>Target 7.2:</strong> substantially increase the share of renewable energy. This is the VIP’s 2026–27 focus on hydrogen, storage, and campus renewables.</li>
          <li><strong>Target 7.3:</strong> double the rate of improvement in energy efficiency. This is what the VIP’s building audits deliver.</li>
        </ul>
      </div>
      <div>
        <span class="eyebrow">Georgia Tech’s commitment</span>
        <h2>Sustainability Next and the Climate Action Plan</h2>
        <p>
          Georgia Tech’s strategic plan asks the Institute to “lead by example.” Its
          <a href="https://sustain.gatech.edu/sustainability-next-plan/">Sustainability Next</a> plan delivered the 2024
          <a href="https://sustain.gatech.edu/2024/04/05/climate-action-plan-provides-road-map-to-net-zero-emissions/">Climate Action Plan</a>,
          with targets to cut emissions <strong>50% by 2030</strong>, reach <strong>net-zero by 2050</strong>, and move
          toward 100% clean energy. Two of the plan’s
          <a href="https://www.gatech.edu/news/2022/10/24/sustainability-next-task-force-delivers-vision-and-launches-implementation">six priorities</a>,
          Education for Sustainable Development and the Living Learning Campus, call for students to learn by working on
          campus itself. That is the Energy Solutions VIP model.
        </p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split">
      <div>
        <span class="eyebrow">The lever we control</span>
        <h2>The cleanest energy is the energy a building never uses</h2>
        <p>
          Every kilowatt-hour a building wastes through old lighting, leaky windows, or poorly zoned HVAC is pulled from
          that 54%-fossil grid. Fixing waste is usually the cheapest and fastest way to cut emissions, and it pays for
          itself in lower utility bills.
        </p>
        <p>
          The Kendeda Building shows how far that can go. It was designed to use so little energy that its rooftop solar
          produced <strong>194%</strong> of its electricity in FY2025. Most campus buildings are decades older. Finding
          their waste is exactly what the <a href="/the-vip">Energy Solutions VIP</a> trains students to do.
        </p>
      </div>
      <div class="video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/W134QA1mFpY"
          title="Solar: The Last Step For Net-Positive Energy at The Kendeda Building"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
        <p class="cite">
          Video: The Kendeda Building (YouTube). Data:
          <a href="https://sustain.gatech.edu/files/2026/02/Georgia-Tech-2025-Annual-Utility-Report-Final-1.pdf">FY2025 Annual Utility Report</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section cta-plain">
    <div class="wrap">
      <h2>You don’t have to wait until graduation</h2>
      <p class="lead">
        In Fall 2025, VIP students audited four campus buildings, and campus planning is now using their findings. You can
        do that work, for credit, starting next semester.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/the-vip">Meet the VIP</a>
        <a class="btn btn-outline" href="/get-involved">Other ways to help</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .personal {
    margin-top: 1.5rem;
  }
  .personal .big {
    display: block;
    font-size: clamp(2rem, 4.5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--navy);
    margin: 0.5rem 0 0.6rem;
  }
  .mixchart {
    margin: 1.5rem 0 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .legend {
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sw {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 3px;
  }
  .fossil {
    background: repeating-linear-gradient(45deg, #c0612b 0 6px, #a9531f 6px 8px);
  }
  .clean {
    background: #2f8f5b;
  }
  .bars {
    display: grid;
    gap: 2px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 8.5rem 1fr 5.5rem;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.5rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font: inherit;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .bar-row:hover,
  .bar-row[aria-pressed='true'] {
    background: var(--gold-soft);
  }
  .bar-label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .bar-track {
    height: 1.1rem;
  }
  .bar {
    display: block;
    height: 100%;
    min-width: 4px;
    border-radius: 0 4px 4px 0;
  }
  .bar-value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
    line-height: 1.2;
  }
  .kind {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
  }
  .detail {
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    border-left: 4px solid var(--gold);
    background: var(--bg);
    border-radius: 0 8px 8px 0;
    min-height: 6rem;
  }
  .detail strong {
    color: var(--navy);
  }
  .detail p {
    margin: 0.3rem 0 0;
    color: var(--muted);
  }
  .table-view {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .table-view summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--navy);
  }
  .table-view table {
    margin-top: 0.6rem;
    border-collapse: collapse;
    width: 100%;
    max-width: 28rem;
  }
  .table-view th,
  .table-view td {
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 560px) {
    .bar-row {
      grid-template-columns: 6.5rem 1fr 4.5rem;
      gap: 0.5rem;
    }
    .bar-label {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLButtonElement>('.bar-row');
  const title = document.getElementById('mix-title');
  const note = document.getElementById('mix-note');

  function show(row: HTMLButtonElement) {
    rows.forEach((r) => r.setAttribute('aria-pressed', String(r === row)));
    if (title) title.textContent = `${row.dataset.label}: ${row.dataset.pct}%`;
    if (note) note.textContent = row.dataset.note ?? '';
  }

  rows.forEach((row) => {
    row.addEventListener('click', () => show(row));
    row.addEventListener('mouseenter', () => show(row));
  });
</script>
