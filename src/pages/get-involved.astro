---
import Layout from '../layouts/Layout.astro';

type Time = 'quick' | 'weekly' | 'semester';
type Interest = 'build' | 'data' | 'policy' | 'campus';

interface Item {
  name: string;
  url: string;
  desc: string;
  how: string;
  time: Time;
  interests: Interest[];
  tags: string[];
}

const items: Item[] = [
  {
    name: 'Tour the Kendeda Building',
    url: 'https://livingbuilding.gatech.edu/visit/tours',
    desc: 'See a net-positive solar building up close: the solar canopy, rainwater cistern, and composting systems.',
    how: 'Request a free guided group tour at least two weeks ahead, or take the virtual tour.',
    time: 'quick',
    interests: ['campus', 'build'],
    tags: ['Free', 'Any major'],
  },
  {
    name: 'SDG Week 2027',
    url: 'https://sustain.gatech.edu/sdg-week/',
    desc: 'A campus-wide week of talks, workshops, and events on the UN Sustainable Development Goals, March 1–5, 2027.',
    how: 'Attend an event, or have your student org submit one to host.',
    time: 'quick',
    interests: ['policy', 'campus', 'data', 'build'],
    tags: ['Mar 1–5, 2027'],
  },
  {
    name: 'Students Organizing for Sustainability (SOS)',
    url: 'https://sos.gtorg.gatech.edu/',
    desc: 'Georgia Tech’s student sustainability group. Its projects include the Community Garden, the Kendeda rooftop garden, hydroponics, Bird Safe Campus, and urban agriculture.',
    how: 'Come to a general body meeting or join an active project. Volunteer garden shifts are listed on the SOS site.',
    time: 'weekly',
    interests: ['build', 'campus'],
    tags: ['Any major', 'Hands-on'],
  },
  {
    name: 'Energy Club',
    url: 'https://energyclub.gatech.edu/',
    desc: 'Georgia Tech’s main student group for energy technology, policy, and business. It runs biweekly meetings, Energy Chats, EnergyHack, and the Southeastern Energy Conference.',
    how: 'Join the mailing list on the club’s Connect page and come to a general body meeting. Instagram: @gt_energyclub.',
    time: 'weekly',
    interests: ['build', 'data', 'policy', 'campus'],
    tags: ['Any major'],
  },
  {
    name: 'Georgia Tech Solar Racing',
    url: 'https://solarracing.gatech.edu/',
    desc: 'Design, build, and race a solar-powered car. The team placed 3rd in its category at the 2025 Formula Sun Grand Prix.',
    how: 'Apply on the team’s Join page. Mechanical, electrical, software, and business roles are available.',
    time: 'weekly',
    interests: ['build'],
    tags: ['Hands-on'],
  },
  {
    name: 'ElectrifyGT',
    url: 'https://gatech.campuslabs.com/engage/organization/electrify-gt',
    desc: 'A student campaign pushing for the electrification of campus buildings and systems.',
    how: 'Follow and message the group on Engage to join.',
    time: 'weekly',
    interests: ['policy', 'campus'],
    tags: ['Advocacy'],
  },
  {
    name: 'Solar Decathlon at Georgia Tech',
    url: 'https://gatech.campuslabs.com/engage/organization/solar-decathlon-at-georgia-tech',
    desc: 'Design a high-performance, solar-powered building for the U.S. Department of Energy’s Solar Decathlon competition.',
    how: 'Join through Engage. It’s a good fit for architecture, building, and engineering students.',
    time: 'weekly',
    interests: ['build', 'campus'],
    tags: ['Competition'],
  },
  {
    name: 'Propose a project to SGA',
    url: 'https://www.sga.gatech.edu/infrastructure-and-sustainability-jac/',
    desc: 'SGA’s Infrastructure & Sustainability committee funds up to $75,000 a year in campus sustainability projects from student fees.',
    how: 'Submit a proposal through the committee’s form with a description, costs, and approvals.',
    time: 'weekly',
    interests: ['campus', 'policy'],
    tags: ['$75K / year'],
  },
  {
    name: 'Office of Sustainability jobs & fellowship',
    url: 'https://sustain.gatech.edu/job-opportunities/',
    desc: 'Paid student assistant roles and the Living Learning Campus Fellowship, a one- to two-semester project tied to the Climate Action Plan.',
    how: 'Applications typically open in early spring. Watch the page or email sustain@gatech.edu.',
    time: 'semester',
    interests: ['campus', 'data', 'policy'],
    tags: ['Paid', 'Opens early spring'],
  },
  {
    name: 'Other sustainability VIP teams',
    url: 'https://vip.gatech.edu/teams-all-in-one/',
    desc: 'Earn credit on a different multi-year research team. Filter the VIP list by SDG 7 (clean energy) or SDG 13 (climate action) to see options like GROWER and EcoCAR.',
    how: 'Sophomores and above apply on the VIP website. Teams take students from many majors.',
    time: 'semester',
    interests: ['build', 'data'],
    tags: ['For credit'],
  },
  {
    name: 'Carbon Reduction Challenge',
    url: 'https://carbonreduction.gatech.edu/home',
    desc: 'Find and pitch real emissions cuts at your internship or co-op employer. Prizes run up to $2,000.',
    how: 'Email carbonreduction@gatech.edu before your next internship.',
    time: 'semester',
    interests: ['policy', 'data'],
    tags: ['Prizes', 'Internship'],
  },
];

const groups: { time: Time; title: string; blurb: string }[] = [
  { time: 'quick', title: 'Try it this week', blurb: 'An hour or less. No commitment.' },
  { time: 'weekly', title: 'Join a team', blurb: 'A few hours a week alongside other students.' },
  { time: 'semester', title: 'Go deep', blurb: 'A semester or more, for credit, pay, or prizes.' },
];
---

<Layout title="Get Involved">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Get Involved</span>
      <h1>Find your fit.</h1>
      <p class="lead">
        The Energy Solutions VIP is the deepest way in, but it isn’t the only one. Answer two questions and we’ll tell
        you whether the VIP fits you, and which other campus sustainability projects do.
      </p>
    </div>
  </section>

  <section class="section band" id="quiz" style="padding-top: 3rem; padding-bottom: 3rem">
    <div class="wrap">
      <form class="quiz" aria-describedby="quiz-help">
        <h2>Find your fit</h2>
        <p id="quiz-help">Pick one answer for each question. The list below updates instantly.</p>
        <fieldset>
          <legend>1. How much time do you have?</legend>
          <label><input type="radio" name="time" value="quick" /> An hour or two</label>
          <label><input type="radio" name="time" value="weekly" /> A few hours a week</label>
          <label><input type="radio" name="time" value="semester" /> A semester, for credit or pay</label>
        </fieldset>
        <fieldset>
          <legend>2. What sounds most like you?</legend>
          <label><input type="radio" name="interest" value="build" /> I like building things</label>
          <label><input type="radio" name="interest" value="data" /> I like data and research</label>
          <label><input type="radio" name="interest" value="policy" /> I like business, policy, or persuading people</label>
          <label><input type="radio" name="interest" value="campus" /> I want to change how campus runs</label>
        </fieldset>
        <div class="quiz-foot">
          <p class="quiz-result" aria-live="polite"></p>
          <button type="reset" class="btn btn-outline">Show everything</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0">
    <div class="wrap">
      <h2>Start here</h2>
      <article
        class="card item featured"
        id="vip"
        data-time="weekly semester"
        data-interests="build data campus policy"
      >
        <div>
          <span class="tag">For credit</span><span class="tag">Any major</span><span class="tag">Sophomore+</span>
        </div>
        <h3><a href="/the-vip">GT Energy Solutions VIP</a></h3>
        <p>
          Audit real campus buildings, recommend upgrades that campus planning uses, and, in 2026–27, evaluate hydrogen,
          storage, and renewables for Georgia Tech. About four hours a week for 1 credit.
        </p>
        <p class="how"><strong>How to join:</strong> Apply on the VIP website by the first Thursday of the semester.</p>
        <a class="more" href="/the-vip#apply">How to apply →</a>
      </article>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0">
    <div class="wrap">
      <span class="eyebrow">Not interested in this VIP?</span>
      <h2>Other projects making campus more sustainable</h2>
      <p class="group-blurb">
        These student groups, events, and programs are also working on energy, climate, and sustainability at Georgia
        Tech. Every one of them supports the same Sustainability Next goals.
      </p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="section group" data-group={g.time} style="padding-bottom: 0">
        <div class="wrap">
          <h3 class="group-title">{g.title}</h3>
          <p class="group-blurb">{g.blurb}</p>
          <div class="grid">
            {items
              .filter((it) => it.time === g.time)
              .map((it) => (
                <article
                  class="card item"
                  data-time={it.time}
                  data-interests={it.interests.join(' ')}
                >
                  <div>
                    {it.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                  <h3>
                    <a href={it.url}>{it.name}</a>
                  </h3>
                  <p>{it.desc}</p>
                  <p class="how">
                    <strong>How to join:</strong> {it.how}
                  </p>
                  <a class="more" href={it.url}>
                    Visit site →
                  </a>
                </article>
              ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="wrap">
      <p class="empty" hidden>
        Nothing matches that exact combination. Try a different time commitment, or
        <a href="/get-involved">see everything</a>.
      </p>
      <p class="cite">
        Program details were checked in October 2026 and can change. Confirm deadlines on each organization’s site.
        Can’t find a fit? Email the Office of Sustainability at <a href="mailto:sustain@gatech.edu">sustain@gatech.edu</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .quiz {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .quiz fieldset {
    border: 0;
    padding: 0;
    margin: 1.2rem 0 0;
  }
  .quiz legend {
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }
  .quiz label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0.5rem 0.5rem 0;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.95rem;
  }
  .quiz label:has(input:checked) {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .quiz input {
    accent-color: var(--gold);
  }
  .quiz-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }
  .quiz-result {
    margin: 0;
    font-weight: 600;
    color: var(--green);
  }
  .quiz .btn {
    background: transparent;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .group-blurb {
    color: var(--muted);
  }
  .item {
    display: flex;
    flex-direction: column;
  }
  .item .how {
    margin-top: 0.8rem;
    font-size: 0.92rem;
  }
  .item .more {
    margin-top: auto;
    padding-top: 0.8rem;
  }
  .item.featured {
    border: 2px solid var(--gold);
    max-width: 40rem;
  }
  .group-title {
    font-size: 1.4rem;
    margin-bottom: 0.2rem;
  }
  .item.match {
    border-color: var(--green);
    box-shadow: 0 0 0 3px var(--green-soft);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.quiz');
  const result = document.querySelector<HTMLElement>('.quiz-result');
  const empty = document.querySelector<HTMLElement>('.empty');
  const items = document.querySelectorAll<HTMLElement>('.item');
  const groups = document.querySelectorAll<HTMLElement>('.group');
  const vip = document.getElementById('vip');

  function update() {
    if (!form) return;
    const data = new FormData(form);
    const time = data.get('time');
    const interest = data.get('interest');
    let shown = 0;

    items.forEach((el) => {
      const okTime = !time || (el.dataset.time ?? '').split(' ').includes(String(time));
      const okInterest = !interest || (el.dataset.interests ?? '').split(' ').includes(String(interest));
      const visible = okTime && okInterest;
      el.hidden = !visible;
      el.classList.toggle('match', visible && Boolean(time || interest));
      if (visible) shown++;
    });

    groups.forEach((g) => {
      g.hidden = !g.querySelector('.item:not([hidden])');
    });

    if (empty) empty.hidden = shown > 0;
    if (result) {
      const others = vip && !vip.hidden ? shown - 1 : shown;
      const more = `${others} other ${others === 1 ? 'match' : 'matches'} highlighted below.`;
      if (!time && !interest) result.textContent = '';
      else if (vip && !vip.hidden) result.textContent = `The Energy Solutions VIP fits you! Plus ${more}`;
      else result.textContent = `The VIP needs a few hours a week, so it may not fit right now. ${more}`;
    }
  }

  form?.addEventListener('change', update);
  form?.addEventListener('reset', () => setTimeout(update));
</script>
