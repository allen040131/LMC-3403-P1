---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Get Involved">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Get Involved</span>
      <h1>Join the GT Energy Solutions VIP.</h1>
      <p class="lead">
        A Vertically Integrated Project (VIP) is a team where students of different years work together on a long-term
        project. This one focuses on energy solutions.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <h2>Three ways to start</h2>
      <div class="grid">
        <div class="card">
          <div class="num">1</div>
          <h3>Learn more</h3>
          <p>Read about the team's current projects and goals.</p>
        </div>
        <div class="card">
          <div class="num">2</div>
          <h3>Reach out</h3>
          <p>Ask questions. No experience required to start a conversation.</p>
        </div>
        <div class="card">
          <div class="num">3</div>
          <h3>Join a project</h3>
          <p>Pick a project that fits your major and interests.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split">
      <div>
        <h2>Ready to help?</h2>
        <p>
          Sign up and contact details:
          <span class="placeholder">[PLACEHOLDER: VIP sign-up link / contact email]</span>
        </p>
        <p>
          Meeting time and place:
          <span class="placeholder">[PLACEHOLDER: when and where the VIP meets]</span>
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#">Sign up</a>
          <a class="btn btn-outline" href="/issue">Back to the issue</a>
        </div>
      </div>
      <div>
        <h2>Who it's for</h2>
        <ul class="checklist">
          <li>Engineering, computing, business, and policy majors</li>
          <li>Anyone curious about clean energy</li>
          <li>Students who want hands-on project experience</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
