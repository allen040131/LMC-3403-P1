---
import Layout from '../layouts/Layout.astro';

const sources = [
  ['Georgia Tech. “Students Take the Lead in Campus Energy Decisions Through Hands-On VIP Course.” February 27, 2026. (Source of the Energy Solutions team photo.)', 'https://news.gatech.edu/news/2026/02/27/students-take-lead-campus-energy-decisions-through-hands-vip-course'],
  ['Georgia Tech Research. “GT Energy Efficiency Through Student-Led Energy Audits.” SDG Week event, March 5, 2026.', 'https://research.gatech.edu/gt-energy-efficiency-through-student-led-energy-audits'],
  ['Vertically Integrated Projects. “GT Energy Solutions” team listing.', 'https://vip.gatech.edu/teams-all-in-one/entry/1252/'],
  ['Georgia Tech. “VIP Syllabus, GT Clean Energy Team (V27), Fall 2026.”', 'https://syllabus.gatech.edu/sites/default/files/2026-04/VIP-Syllabus-%20Revised-Fall-2026_1.pdf'],
  ['Vertically Integrated Projects. “Prospective Students.”', 'https://vip.gatech.edu/prospective-students/'],
  ['Vertically Integrated Projects. “Policies for Students.”', 'https://vip.gatech.edu/policies-students/'],
  ['Georgia Tech Office of the President. “The Power of Vertically Integrated Projects.”', 'https://president.gatech.edu/blog/power-vertically-integrated-projects-innovation-education-georgia-tech-world'],
  ['Georgia Tech Research Institute. “Creating a Pipeline of Future Technology Leaders.” YouTube.', 'https://www.youtube.com/watch?v=EmqrYSn5oNs'],
  ['United Nations. “Goal 7: Ensure access to affordable, reliable, sustainable and modern energy for all.”', 'https://sdgs.un.org/goals/goal7'],
  ['Georgia Tech Office of Sustainability. “Sustainability Next Plan.”', 'https://sustain.gatech.edu/sustainability-next-plan/'],
  ['Georgia Tech. “The Sustainability Next Task Force Delivers Vision and Launches Implementation.” October 24, 2022.', 'https://www.gatech.edu/news/2022/10/24/sustainability-next-task-force-delivers-vision-and-launches-implementation'],
  ['Georgia Tech. “Climate Action Plan Provides Road Map to Net-Zero Emissions.” April 5, 2024.', 'https://sustain.gatech.edu/2024/04/05/climate-action-plan-provides-road-map-to-net-zero-emissions/'],
  ['Georgia Tech. “Annual Utility Report, FY2025.” February 2026.', 'https://sustain.gatech.edu/files/2026/02/Georgia-Tech-2025-Annual-Utility-Report-Final-1.pdf'],
  ['Georgia Tech Office of Sustainability. “2025 Sustainability Report.” February 2026.', 'https://sustain.gatech.edu/files/2026/02/2025-Sustainability-Report_2.2026_SPREADS.pdf'],
  ['Georgia Tech Office of Sustainability. “Emissions.”', 'https://sustain.gatech.edu/impact-area-emissions/'],
  ['U.S. Energy Information Administration. “Net Generation by State by Type of Producer by Energy Source, 1990–2024.”', 'https://www.eia.gov/electricity/data/state/'],
  ['U.S. Energy Information Administration. “Plant Vogtle Unit 4 begins commercial operation.” May 1, 2024.', 'https://www.eia.gov/todayinenergy/detail.php?id=61963'],
  ['Georgia Tech. “The Kendeda Building: Living Building Challenge.”', 'https://livingbuilding.gatech.edu/living-building-challenge'],
  ['The Kendeda Building. “Solar: The Last Step For Net-Positive Energy at The Kendeda Building.” YouTube.', 'https://www.youtube.com/watch?v=W134QA1mFpY'],
  ['Atlanta Journal-Constitution. “Georgia Power Floats Plan for Small Savings to Customers’ Bills.” February 18, 2026.', 'https://www.ajc.com/business/2026/02/georgia-power-floats-plan-to-lower-customers-monthly-bills'],
  ['American Council for an Energy-Efficient Economy. “Energy Burdens in Atlanta.” September 2020.', 'https://www.aceee.org/sites/default/files/pdfs/aceee-01_energy_burden_-_atlanta.pdf'],
  ['E2 (Environmental Entrepreneurs). “Clean Jobs Georgia 2025.”', 'https://e2.org/reports/clean-jobs-georgia-2025'],
  ['Vertically Integrated Projects. Home page. (Source of the team-meeting, outdoor-classroom, and poster-fair photos on The VIP page.)', 'https://vip.gatech.edu/'],
  ['Daderot. “G. Wayne Clough Undergraduate Learning Commons, Georgia Institute of Technology.” Wikimedia Commons, CC0. (Sources page header photo.)', 'https://commons.wikimedia.org/wiki/File:G._Wayne_Clough_Undergraduate_Learning_Commons_-_Georgia_Institute_of_Technology_-_DSC00776.JPG'],
  ['KBISD. “Kendeda Building Exterior.” Wikimedia Commons, CC BY-SA 4.0. (Get Involved page header photo.)', 'https://commons.wikimedia.org/wiki/File:Kendeda_Building_Exterior.jpg'],
  ['KBISD. “Kendeda Building Solar Canopy.” Wikimedia Commons, CC BY-SA 4.0. (Aerial solar canopy photo on the Issue page.)', 'https://commons.wikimedia.org/wiki/File:Kendeda_Building_Solar_Canopy.jpg'],
  ['Georgia Tech Research Institute. “Georgia Tech Aquatic Center Solar Panels.” Wikimedia Commons, CC BY 3.0. (Rooftop solar photo on the Home page.)', 'https://commons.wikimedia.org/wiki/File:Georgia_Tech_Aquatic_Center_Solar_Panels.jpg'],
  ['Marc Merlin. “Panorama of the midtown Atlanta skyline from the rooftop garden of the Clough Undergraduate Learning Commons at Georgia Tech, October 2015.” Wikimedia Commons, CC BY-SA 4.0. (Issue page header photo.)', 'https://commons.wikimedia.org/wiki/File:Panorama_of_the_midtown_Atlanta_skyline_from_the_rooftop_garden_of_the_Clough_Undergraduate_Learning_Commons_at_Georgia_Tech,_October_2015.jpg'],
  ['Students Organizing for Sustainability. Home page.', 'https://sos.gtorg.gatech.edu/'],
  ['Georgia Tech Campus Services. “Sustainability in Campus Services.”', 'https://sustainability.campusservices.gatech.edu/'],
];
---

<Layout title="Sources">
  <section class="photo-hero sources-hero">
    <img
      class="bg"
      src="/images/campus-clough-commons.jpg"
      width="1920"
      height="1280"
      alt=""
      fetchpriority="high"
    />
    <div class="wrap">
      <div class="copy">
        <span class="eyebrow">Sources &amp; Resources</span>
        <h1>Where our facts come from, and where to learn more.</h1>
        <p class="lead">
          Every number on this site links back to Georgia Tech, United Nations, U.S. government, or other published
          sources.
        </p>
      </div>
    </div>
    <p class="photo-credit">
      Clough Undergraduate Learning Commons. Photo:
      <a href="https://commons.wikimedia.org/wiki/File:G._Wayne_Clough_Undergraduate_Learning_Commons_-_Georgia_Institute_of_Technology_-_DSC00776.JPG">Daderot</a>,
      <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>
    </p>
  </section>

  <section class="section band">
    <div class="wrap split">
      <div>
        <h2>Stay in the loop</h2>
        <ul class="checklist">
          <li><a href="/the-vip">GT Energy Solutions VIP</a>: instructor Jairo Garcia, <a href="mailto:Jairo.garcia@design.gatech.edu">Jairo.garcia@design.gatech.edu</a></li>
          <li><a href="https://sustain.gatech.edu/">Office of Sustainability</a>. Instagram: @SustainAtGatech. Email: <a href="mailto:sustain@gatech.edu">sustain@gatech.edu</a></li>
          <li><a href="https://energyclub.gatech.edu/">Energy Club</a>: mailing list, events, and Instagram @gt_energyclub</li>
          <li><a href="https://energy.gatech.edu/education/gt-students">Strategic Energy Institute</a>: “Connections” jobs and events newsletter</li>
          <li><a href="https://livingbuilding.gatech.edu/visit/tours">Kendeda Building</a>: tours and live building performance</li>
        </ul>
      </div>
      <div>
        <h2>Read the plans</h2>
        <ul class="checklist">
          <li><a href="https://sustain.gatech.edu/2024/04/05/climate-action-plan-provides-road-map-to-net-zero-emissions/">Georgia Tech Climate Action Plan</a>: the road map to net-zero by 2050</li>
          <li><a href="https://sustain.gatech.edu/sustainability-next-plan/">Sustainability Next</a>: the Institute’s sustainability strategy</li>
          <li><a href="https://sustain.gatech.edu/files/2026/02/Georgia-Tech-2025-Annual-Utility-Report-Final-1.pdf">FY2025 Annual Utility Report</a>: campus energy data</li>
          <li><a href="https://sdgs.un.org/goals/goal7">UN SDG 7</a>: the global targets for clean energy</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Sources</h2>
      <ol class="sources">
        {
          sources.map(([text, url]) => (
            <li>
              {text} <a href={url}>{url}</a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .sources-hero {
    min-height: clamp(420px, 60vh, 560px);
    padding: clamp(4rem, 10vw, 6rem) 0;
  }
  .sources-hero .copy {
    max-width: 40rem;
  }
  .sources-hero .bg {
    object-position: 70% 35%;
  }
  .sources {
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .sources li {
    margin-bottom: 0.6rem;
  }
  .sources a {
    word-break: break-all;
  }
</style>
